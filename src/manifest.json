{
  "manifest_version": 3,
  "name": "Email Reader View",
  "version": "2.0.0",
  "description": "Display emails in a more readable format",
  "author": "Email Markup Consortium",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Email Reader View"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["https://mail.google.com/*", "https://outlook.live.com/*", "https://mail.yahoo.com/*", "https://mail.aol.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "email-reader-view@emailmarkup.org",
      "strict_min_version": "121.0"
    }
  }
}
